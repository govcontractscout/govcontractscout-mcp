{
  "name": "govcontractscout-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing GovContractScout's US state & local government contracts API (search contracts, get details, NAICS lookup, AI match scoring) to AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "govcontractscout-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "government-contracts",
    "api",
    "govcontractscout",
    "naics",
    "procurement",
    "rfp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/govcontractscout/govcontractscout-mcp"
  },
  "homepage": "https://github.com/govcontractscout/govcontractscout-mcp",
  "author": "Josef Adlao <jadlao@gmail.com>",
  "mcpName": "io.github.govcontractscout/govcontractscout-mcp",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
