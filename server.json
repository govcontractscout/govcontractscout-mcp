{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.govcontractscout/govcontractscout-mcp",
  "description": "MCP server for the GovContractScout US government contracts API: search, NAICS, match scoring.",
  "repository": {
    "url": "https://github.com/govcontractscout/govcontractscout-mcp",
    "source": "github"
  },
  "version": "1.0.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "govcontractscout-mcp",
      "version": "1.0.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GCS_API_KEY",
          "description": "GovContractScout API key (gcs_live_...) from https://scout.govbidportals.com/api-keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "GOVCONTRACTSCOUT_API_BASE",
          "description": "Optional: API base URL override (defaults to https://scout.govbidportals.com)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
